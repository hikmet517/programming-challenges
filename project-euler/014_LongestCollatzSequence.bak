#lang racket
(define (process-num n)
  (if (equal? (modulo n 2) 0)
      (quotient n 2)
      (+ 1 (* 3 n))))

; tail recursive
(define (process-seq n)
  (define (iter n k)
    (if (equal? n 1)
        (+ k 1)
        (iter (process-num n) (+ 1 k))))
  (iter n 0))

(define (collatzList n)
  (define cache (make-vector n -1))
  (vector-set! cache 0 0)
  (vector-set! cache 1 1)
  (for ([i (in-range 2 n)])
    (cond
      [(= i n) cache]
      [(= (vector-ref cache i) -1) (vector-set! cache i (process-seq i))]
      [else (vector-ref cache i)]))
  cache)

(define (get-max vec)
  (define val (vector-argmax (lambda (x) x) vec))
  (index-of (vector->list vec) val))

(define (calc x)
  (get-max (collatzList x)))
